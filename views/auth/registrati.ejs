<%- include('../partials/head', { titolo: t('a.reg.h1') + ' | Rimborso Km', descrizione: t('a.reg.lead') }) %>
<section class="hero small"><div class="wrap"><h1><%= t('a.reg.h1') %></h1><p class="lead"><%= t('a.reg.lead') %></p></div></section>
<div class="wrap">
  <form class="card auth" method="post" action="<%= PAGINE.registrati[lingua] %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (errore) { %><p class="alert err" role="alert"><%= t('a.err.' + errore) %></p><% } %>
    <label for="nome"><%= t('a.nome') %></label><input id="nome" name="nome" required minlength="2" maxlength="120" autocomplete="name" value="<%= v.nome || '' %>">
    <label for="email"><%= t('a.email') %></label><input id="email" name="email" type="email" required autocomplete="email" value="<%= v.email || '' %>">
    <label for="password"><%= t('a.reg.pw') %></label><input id="password" name="password" type="password" required minlength="8" autocomplete="new-password">
    <div class="hp" aria-hidden="true"><label for="sito">Sito</label><input id="sito" name="sito" tabindex="-1" autocomplete="off"></div>
    <label class="chk"><input type="checkbox" name="privacy" required> <span><%= t('a.reg.privacy') %> (<a href="<%= PAGINE.privacy[lingua] %>" target="_blank" rel="noopener">privacy</a>)</span></label>
    <button class="btn" type="submit"><%= t('a.reg.btn') %></button>
    <p class="hint"><%= t('a.reg.hai') %> <a href="<%= PAGINE.accedi[lingua] %>"><%= t('a.entra') %></a></p>
  </form>
</div>
<%- include('../partials/footer') %>
