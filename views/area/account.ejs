<%- include('../partials/head', { titolo: t('acc.h1') + ' | Rimborso Km', descrizione: t('acc.h1') }) %>
<section class="hero small"><div class="wrap"><h1><%= t('acc.h1') %></h1><p class="lead"><%= utente.email %></p></div></section>
<%- include('_nav') %>
<div class="wrap area">
  <% if (msg && ['salvato','password_ok','password_errata','password_corta','conferma'].includes(msg)) { %><p class="alert <%= ['salvato','password_ok'].includes(msg) ? 'ok' : 'err' %>"><%= t('acc.msg.' + msg) %></p><% } %>
  <div class="grid2">
    <form class="card" method="post" action="<%= PAGINE.account[lingua] %>/profilo">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2><%= t('acc.profilo') %></h2>
      <label for="nome"><%= t('a.nome') %></label><input id="nome" name="nome" required minlength="2" maxlength="120" value="<%= utente.nome %>">
      <p><button class="btn" type="submit"><%= t('acc.salva') %></button></p>
    </form>
    <form class="card" method="post" action="<%= PAGINE.account[lingua] %>/password">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2><%= t('acc.pw') %></h2>
      <label for="att"><%= t('acc.pw.attuale') %></label><input id="att" name="attuale" type="password" required autocomplete="current-password">
      <label for="nuova"><%= t('acc.pw.nuova') %></label><input id="nuova" name="nuova" type="password" required minlength="8" autocomplete="new-password">
      <p><button class="btn" type="submit"><%= t('acc.salva') %></button></p>
    </form>
  </div>
  <div class="card">
    <h2><%= t('acc.dati') %></h2>
    <p><a class="btn alt" href="<%= PAGINE.account[lingua] %>/esporta"><%= t('acc.esporta') %></a></p>
    <h3><%= t('acc.elimina') %></h3>
    <form method="post" action="<%= PAGINE.account[lingua] %>/elimina" class="elimina-account">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <p class="hint"><%= t('acc.elimina.testo') %></p>
      <label for="conf"><%= t('a.email') %></label><input id="conf" name="conferma" type="email" required autocomplete="off">
      <p><button class="btn danger" type="submit"><%= t('acc.elimina.btn') %></button></p>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
