# Database PostgreSQL (Railway lo imposta da solo collegando il servizio Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rimborsokm
# URL pubblico del sito, senza slash finale (canonical, sitemap, og)
PUBLIC_URL=http://localhost:3000
NODE_ENV=production
# Obbligatorio in produzione (sessioni utenti): stringa casuale lunga
SESSION_SECRET=
TZ=Europe/Rome
# 1 = noindex finché il sito non è sul dominio definitivo
NOINDEX=1

# Google Routes API (distanza). Senza chiave i km si inseriscono a mano
GOOGLE_MAPS_API_KEY=
# Tetto giornaliero di chiamate a Google (resta nella quota gratuita mensile)
ROUTES_MAX_GIORNO=40

# Email alert errori via Brevo (API HTTP, mai SMTP)
BREVO_API_KEY=
MAIL_FROM_EMAIL=info@simonescaffidi.it
MAIL_FROM_NAME=Rimborso Km
ALERT_EMAIL=info@simonescaffidi.it

# Endpoint /admin/* (alert-test, aggiornamento manuale, upload file ACI): header X-Admin-Token, min 32 caratteri
ADMIN_TOKEN=

# Google Analytics 4 e Search Console (da impostare con il dominio definitivo)
GA4_ID=
GSC_VERIFICATION=

# Opzionali: sorgenti dati (default ufficiali)
# ACI_BASE_URL=https://aci.gov.it/app/uploads
# MIMIT_PREZZI_URL=https://www.mimit.gov.it/images/exportCSV/prezzo_alle_8.csv
# JOBS_DISABILITATI=1
